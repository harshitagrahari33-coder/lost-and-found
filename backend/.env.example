
HOST=0.0.0.0
PORT=5001
NODE_ENV=development
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_super_secret_access_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here
OTP_HMAC_SECRET=your_super_secret_otp_hmac_hash_key_here

# Institutional email domain allowed for student/staff logins (defaults to kiet.edu)
ALLOWED_EMAIL_DOMAIN=kiet.edu

# ==========================================
# Email Provider Configuration:
# Option 1: Resend (Recommended)
# Obtain an API key from https://resend.com
# For testing before domain verification, use: EMAIL_FROM=KIET Lost & Found <onboarding@resend.dev>
# Once custom domain is verified: EMAIL_FROM=KIET Lost & Found <verify@yourdomain.com>
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=KIET Lost & Found <onboarding@resend.dev>

# Option 2: SMTP (Fallback / Alternative, e.g. Mailtrap, Gmail, Brevo)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Allowed frontend origins for CORS (supports comma-separated list of URLs)
# For local development:
CLIENT_URL=http://localhost:5175
# For public ngrok / mobile testing (also automatically allows *.ngrok-free.dev):
# CLIENT_URL=http://localhost:5175,https://<your-frontend-tunnel>.ngrok-free.dev
# You can also use FRONTEND_URL as an alias:
# FRONTEND_URL=https://<your-frontend-tunnel>.ngrok-free.dev

DEV_OTP_LOG=true

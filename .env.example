# ==============================================================================
# KIET Lost & Found - Frontend Environment Configuration
# ==============================================================================

# LOCAL DEVELOPMENT:
# Point directly to your local backend server
VITE_API_URL=http://localhost:5001/api
VITE_SOCKET_URL=http://localhost:5001

# PUBLIC NGROK / MOBILE TESTING:
# When accessing the frontend from a phone or external device via ngrok,
# point VITE_API_URL to your public backend ngrok tunnel URL:
# VITE_API_URL=https://<your-backend-tunnel>.ngrok-free.dev/api
# VITE_SOCKET_URL=https://<your-backend-tunnel>.ngrok-free.dev
